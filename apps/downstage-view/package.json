{
  "name": "@ontime/downstage-view",
  "private": true,
  "version": "0.1.0-beta.1",
  "description": "Downstage View: read-only macOS/Windows desktop viewer for the hosted cloud presentation viewer (ISSUE-002 S8).",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:main": "tsc -p tsconfig.build.json",
    "build:preload": "vite build -c vite.preload.config.ts",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:unsigned": "npm run build && electron-builder --mac -c.mac.identity=null -c.mac.notarize=false",
    "audit:package": "node scripts/package-audit.cjs dist_out"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "^22.9.0",
    "electron": "43.2.0",
    "electron-builder": "26.11.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.5",
    "vitest": "4.0.10"
  }
}
