{
  "name": "@ontime/ppt-bridge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist-cjs/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/*.test.ts",
    "build:cjs": "rm -rf dist-cjs && tsc -p tsconfig.cjs.json && printf '{\"type\":\"commonjs\"}\n' > dist-cjs/package.json",
    "smoke:cjs": "node test/cjs-smoke.cjs"
  }
}
