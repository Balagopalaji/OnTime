{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2020",
    "verbatimModuleSyntax": false,
    "noEmit": false,
    "outDir": "dist-cjs",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
